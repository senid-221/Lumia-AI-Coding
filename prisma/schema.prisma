generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  projectMembers ProjectMember[]
  providerUsage ProviderUsage[]
  apiKeys ApiKey[]
  integrations Integration[]
  agentTasks AgentTask[]
  notifications Notification[]
  auditLogs AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id            String          @id @default(cuid())
  name          String
  slug          String
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  executions    AgentExecution[]
  memories      ProjectMemory[]
  members       ProjectMember[]
  settings      ProjectSettings?
  attachments   Attachment[]
  providerUsage ProviderUsage[]
  gitRepositories GitRepository[]
  agentTasks    AgentTask[]
  hackingTargets HackingLabTarget[]
  auditLogs     AuditLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, slug])
}

model Conversation {
  id         String          @id @default(cuid())
  title      String?
  userId     String
  projectId  String?
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages   Message[]
  executions AgentExecution[]
  agentTasks AgentTask[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
  createdAt      DateTime     @default(now())
}

model AgentExecution {
  id                String          @id @default(cuid())
  projectId         String?
  conversationId    String?
  status            String
  prompt            String          @db.Text
  result            String?         @db.Text
  error             String?         @db.Text
  toolCount         Int             @default(0)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  cancelRequested   Boolean         @default(false)
  heartbeatAt       DateTime?
  parentExecutionId String?
  parentExecution   AgentExecution?  @relation("ExecutionResumes", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  resumedExecutions AgentExecution[] @relation("ExecutionResumes")
  events            ExecutionEvent[]
  toolCalls         ToolCall[]
  queueAttempts     Int             @default(0)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

model ProjectMemory {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  key       String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, kind])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectSettings {
  id        String   @id @default(cuid())
  projectId String   @unique
  provider  String?
  model     String?
  settings  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Attachment {
  id           String       @id @default(cuid())
  messageId    String?
  projectId    String?
  name         String
  mimeType     String?
  size         Int?
  url          String?
  storageKey   String?
  createdAt    DateTime     @default(now())

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([projectId])
}

model ExecutionEvent {
  id          String         @id @default(cuid())
  executionId String
  type        String
  data        String?        @db.Text
  createdAt   DateTime       @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model ToolCall {
  id          String         @id @default(cuid())
  executionId String
  tool        String
  input       String?        @db.Text
  output      String?        @db.Text
  status      String         @default("completed")
  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, startedAt])
}

model AIProvider {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  baseUrl     String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  models      AIModel[]
  usage       ProviderUsage[]
}

model AIModel {
  id          String   @id @default(cuid())
  providerId  String
  key         String
  name        String
  enabled     Boolean  @default(true)
  contextSize Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, key])
}

model ProviderUsage {
  id          String   @id @default(cuid())
  providerId  String
  userId      String?
  projectId   String?
  model       String?
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  cost        Float?
  createdAt   DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  keyHash    String   @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  name      String
  status    String   @default("active")
  config    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model GitRepository {
  id        String   @id @default(cuid())
  projectId String
  provider  String   @default("github")
  owner     String?
  name      String
  url       String?
  defaultBranch String @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  GitBranch[]
  commits   GitCommit[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, name])
}

model GitBranch {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  sha          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
}

model GitCommit {
  id           String   @id @default(cuid())
  repositoryId String
  sha          String
  message      String?  @db.Text
  author       String?
  createdAt    DateTime @default(now())

  repository GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([repositoryId, createdAt])
}

model AgentTask {
  id           String   @id @default(cuid())
  projectId    String?
  conversationId String?
  userId       String
  type         String   @default("coding")
  status       String   @default("queued")
  prompt       String   @db.Text
  priority     Int      @default(0)
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  runs         TaskRun[]
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([userId, createdAt])
}

model TaskRun {
  id         String   @id @default(cuid())
  taskId     String
  executionId String?
  attempt    Int      @default(1)
  status     String   @default("running")
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  task       AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
}

model HackingLabTarget {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  targetType  String
  target      String
  authorized  Boolean  @default(false)
  labMode     Boolean  @default(true)
  notes       String?  @db.Text
  findings    SecurityFinding[]
  reports     LabReport[]
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecurityFinding {
  id          String   @id @default(cuid())
  targetId    String
  severity    String   @default("info")
  title       String
  description String?  @db.Text
  evidence    String?  @db.Text
  remediation String?  @db.Text
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  target HackingLabTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, severity])
}

model LabReport {
  id        String   @id @default(cuid())
  targetId  String
  title     String
  summary   String?  @db.Text
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  target HackingLabTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?  @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  action    String
  resource  String?
  resourceId String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
}
